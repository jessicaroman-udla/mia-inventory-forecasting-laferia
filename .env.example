# Plantilla de variables de entorno. Copia este archivo como ".env" y
# rellena los valores reales:   cp .env.example .env
# El archivo ".env" NUNCA se sube a Git (esta en .gitignore).

# ============================================================
# Conexion a PostgreSQL (base "inventario", alimentada desde SAP HANA)
# ============================================================
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ============================================================
# Ventanas de fechas del pipeline de extraccion
# ============================================================
# RANKING_START_DATE: desde que fecha se calcula la clasificacion ABC y el
#   precio promedio por producto.  (por defecto: 2025-06-01)
# WAREHOUSE_SALES_START_DATE: desde que fecha se calculan las ventas por
#   sucursal usadas por el algoritmo genetico.  (por defecto: 2025-12-01)
RANKING_START_DATE=2025-06-01
WAREHOUSE_SALES_START_DATE=2025-12-01

# ============================================================
# Deploy / ejecucion remota (solo si usas fabfile.py)
# ============================================================
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_PROJECT_DIR=~/mia-inventory-forecasting-laferia
